# .env.production.example — Copy to .env and fill in real values
#
# Usage:
#   cp .env.production.example .env
#   # Edit .env with production secrets
#   docker compose up -d --build

# --- Caddy / Domain ---
# For localhost (self-signed TLS): SITE_ADDRESS=localhost
# For production: SITE_ADDRESS=your-domain.com
SITE_ADDRESS=localhost

# --- Server ---
PORT=3000
CLIENT_URL=https://localhost

# --- Database ---
POSTGRES_USER=zvonok_admin
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=zvonok

# --- JWT Secrets (generate with: openssl rand -hex 64) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN_MINUTES=15
JWT_REFRESH_EXPIRES_IN_DAYS=7

# --- Client (baked into static build at build time) ---
# Leave empty for same-origin requests when behind Caddy proxy.
# Caddy serves the client and proxies /api/* to the server,
# so the client can use relative URLs.
VITE_API_BASE_URL=
VITE_SOCKET_URL=

# --- mediasoup / WebRTC media ---
# Listen on all interfaces inside Docker
MEDIASOUP_LISTEN_IP=0.0.0.0
# Set to the server's public IP (required for remote clients)
MEDIASOUP_ANNOUNCED_IP=YOUR_SERVER_PUBLIC_IP
RTC_MIN_PORT=40000
RTC_MAX_PORT=40099

# --- TURN server (coturn) ---
# Static credentials for TURN authentication
TURN_USER=zvonok
TURN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Public IP of the server (required for TURN relay to work)
TURN_EXTERNAL_IP=YOUR_SERVER_PUBLIC_IP
