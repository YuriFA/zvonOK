{
  "name": "@zvonok/react",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "sideEffects": ["*.css"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuriFA/zvonOK.git",
    "directory": "packages/react"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./zvonok.css": "./src/prebuilt/zvonok.css"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./zvonok.css": "./dist/prebuilt/zvonok.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/prebuilt/zvonok.css dist/prebuilt/zvonok.css",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:run": "vitest run",
    "lint:ts": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@zvonok/client": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^28.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io-client": "^4.8.3",
    "typescript": "~5.8.3",
    "vite": "^7.1.6",
    "vitest": "^4.0.18"
  }
}
