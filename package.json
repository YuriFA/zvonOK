{
  "name": "webrtc-chat",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm --stream -r run dev",
    "clean": "rm -rf .parcel-cache && pnpm -r run clean",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "lint:ts": "pnpm -r run lint:ts",
    "test": "pnpm test:client && pnpm test:server && pnpm -C apps/server test:e2e",
    "test:client": "pnpm -C apps/client test:run",
    "test:server": "pnpm -C apps/server test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "mediasoup",
      "@prisma/engines",
      "prisma",
      "@nestjs/core",
      "esbuild",
      "@tailwindcss/oxide",
      "unrs-resolver",
      "@scarf/scarf"
    ]
  }
}
