// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String       @id @default(cuid())
  email               String       @unique
  username            String       @unique
  passwordHash        String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  refreshTokenHash    String?
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  tokenVersion        Int          @default(0)
  role                Role         @default(USER)
  rooms               Room[]       @relation("RoomHost")
  messages            Message[]
  callRecords         CallRecord[] @relation("CallRecords")
  developerAccount    DeveloperAccount? @relation("DeveloperUser")
}

model CallRecord {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation("CallRecords", fields: [ownerId], references: [id], onDelete: Cascade)
  roomName     String
  roomSlug     String
  startedAt    DateTime
  endedAt      DateTime
  messageCount Int
  messages     Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId])
}

model Room {
  id              String     @id @default(cuid())
  name            String?
  slug            String     @unique
  ownerId         String?
  owner           User?      @relation("RoomHost", fields: [ownerId], references: [id])
  projectId       String?
  project         Project?   @relation(fields: [projectId], references: [id])
  isPublic        Boolean    @default(true)
  maxParticipants Int        @default(10)
  status          RoomStatus @default(active)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  endedAt         DateTime?
  egressSessions  Egress[]
  messages        Message[]

  @@index([ownerId])
  @@index([projectId])
  @@index([status])
  @@index([isPublic])
}

model DeveloperAccount {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  user         User?     @relation("DeveloperUser", fields: [userId], references: [id], onDelete: Cascade)
  userId       String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]

  @@index([username])
}

model Project {
  id                 String           @id @default(cuid())
  name               String
  developerAccount   DeveloperAccount @relation(fields: [developerAccountId], references: [id], onDelete: Cascade)
  developerAccountId String
  webhookUrl         String?
  webhookSecret      String?
  apiKeys            ApiKey[]
  rooms              Room[]
  egressSessions     Egress[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([developerAccountId])
}

model ApiKey {
  id        String    @id @default(cuid())
  keyHash   String    @unique
  prefix    String
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([projectId])
}

model Egress {
  id                   String             @id @default(cuid())
  roomId               String
  room                 Room               @relation(fields: [roomId], references: [id])
  projectId            String
  project              Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outputs              Json
  status               EgressStatus       @default(starting)
  endedReason          EgressEndedReason?
  error                String?
  recordingSizeBytes   BigInt?
  recordingFinalizedAt DateTime?
  startedAt            DateTime           @default(now())
  endedAt              DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([roomId])
  @@index([projectId])
}

enum EgressStatus {
  starting
  live
  stopping
  ended
  failed
}

enum EgressEndedReason {
  stopped
  roomEnded
}

model Message {
  id        String   @id @default(cuid())
  content   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId   String?
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([roomId])
  @@index([userId])
  @@index([guestId])
}

enum Role {
  USER
  HOST
  ADMIN
}

enum RoomStatus {
  active
  ended
}
