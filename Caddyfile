# Caddyfile — Caddy reverse proxy for WebRTC Chat
#
# Usage:
#   Development (localhost with self-signed TLS):
#     SITE_ADDRESS=localhost is the default
#
#   Production (real domain with automatic Let's Encrypt):
#     Set SITE_ADDRESS=your-domain.com in environment
#
# The {$SITE_ADDRESS:localhost} syntax means:
#   use env var SITE_ADDRESS, default to "localhost" if unset.
#
# Routing strategy:
#   NestJS has no /api prefix. Backend routes (/auth, /users, /rooms, etc.)
#   are proxied explicitly. Everything else is served as static files
#   with SPA fallback to index.html.

# When SITE_ADDRESS is an IP, some TLS clients (macOS LibreSSL, older
# curl, etc.) don't send SNI. The default_sni ensures Caddy still
# serves the correct certificate for SNI-less connections.
{
	default_sni {$SITE_ADDRESS:localhost}
}

# Browsers can fetch http://<ip>/ca.crt without trusting TLS first.
http://{$SITE_ADDRESS:localhost} {
	# Everything else → redirect to HTTPS as usual
	handle {
		redir https://{host}{uri} permanent
	}
}

{$SITE_ADDRESS:localhost} {
	# For real domains: Caddy auto-obtains Let's Encrypt certs.
	# For localhost/IP: uncomment the next line for self-signed TLS.
	# tls internal

	# Serve client static files (built by Vite)
	root * /srv/client

	# --- Backend API routes -> NestJS ---
	handle /auth/* {
		reverse_proxy server:3000
	}

	handle /version {
		reverse_proxy server:3000
	}

	handle /users/* {
		reverse_proxy server:3000
	}

	handle /rooms {
		reverse_proxy server:3000
	}

	handle /rooms/* {
		reverse_proxy server:3000
	}

	# Swagger UI and JSON spec
	handle /swagger* {
		reverse_proxy server:3000
	}

	# Socket.io transport (SFU WebSocket + polling fallback)
	handle /socket.io/* {
		reverse_proxy server:3000
	}

	# --- Static files + SPA fallback ---
	handle {
		# Compress responses with zstd (preferred) and gzip fallback
		encode zstd gzip

		# Immutable cache for Vite hashed assets (JS, CSS)
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Logging
	log {
		output stdout
		format console
	}
}
