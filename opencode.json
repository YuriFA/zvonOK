{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "skill": {
      "gc": "allow"
    },
    "bash": {
      "*": "ask",
      "docker compose ps*": "allow",
      "docker compose*": "allow",
      "npx prisma migrate*": "allow",
      "pnpm add*": "allow",
      "find *": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "rm -rf*": "deny",
      "git push*": "deny"
    }
  },
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest"
  ]
}
