# Dockerfile.caddy — Caddy with baked-in client static assets
#
# Stage 1: Build client assets (same as apps/client/Dockerfile)
# Stage 2: Caddy with assets copied in — no shared volume needed

# --- Stage 1: Build ---
FROM node:22-alpine AS builder

WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY apps/client/package.json ./apps/client/

RUN pnpm install --frozen-lockfile

COPY apps/client ./apps/client

ARG VITE_API_BASE_URL=""
ARG VITE_SOCKET_URL=""

RUN pnpm -C apps/client build

# --- Stage 2: Caddy with static assets ---
FROM caddy:2-alpine

COPY --from=builder /app/apps/client/dist /srv/client
