# Dockerfile.caddy — Caddy with baked-in client static assets
#
# Stage 1: Build client assets
# Stage 2: Caddy with assets copied in — no shared volume needed

# --- Stage 1: Build ---
FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM base AS build
COPY . /app
WORKDIR /app

RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

ARG VITE_API_BASE_URL=""
ARG VITE_SOCKET_URL=""

RUN pnpm -C apps/client build

# --- Stage 2: Caddy with static assets ---
FROM caddy:2-alpine

COPY --from=build /app/apps/client/dist /srv/client
